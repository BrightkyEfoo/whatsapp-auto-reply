# OpenAI API Key
OPENAI_API_KEY=sk-your-api-key-here

# Numéro WhatsApp de ta copine (format: 2376XXXXXXXX@c.us)
GIRLFRIEND_NUMBER=237656673399@c.us

# Port du serveur
PORT=3000

# Nombre maximum de messages avant "je vais dormir"
MAX_MESSAGES=3

# Délai de réponse en secondes (pour paraître naturel)
RESPONSE_DELAY_MIN=3
RESPONSE_DELAY_MAX=8

# ========== MESSAGES MATINAUX ==========

# Heure de début d'envoi des messages matinaux (format 24h)
MORNING_START_HOUR=8

# Heure de fin d'envoi des messages matinaux (format 24h)
MORNING_END_HOUR=10

# Nombre minimum de messages à envoyer le matin
MORNING_MIN_MESSAGES=2

# Nombre maximum de messages à envoyer le matin
MORNING_MAX_MESSAGES=6

# Utiliser l'IA pour générer les messages matinaux (true/false)
# false = utilise des messages prédéfinis
USE_AI_MORNING=true
